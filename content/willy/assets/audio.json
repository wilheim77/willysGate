    "bossPhase": { "src": "assets/audio/sfx/boss_phase.ogg" },
    "trapdoor": { "src": "assets/audio/sfx/trapdoor.ogg" },
    "rivalSting": { "src": "assets/audio/sfx/rival.ogg" }
  },
  "events": {
    "combatStarted": { "sfx": "tvJingle", "music": "combat" },
    "attackRolled": [
      { "field": "hit", "map": { "false": "miss" } },
      { "field": "crit", "map": { "true": ["critHit", "crowdApplause"] } },
      { "field": "natural", "map": { "1": "crowdBoo" } }
    ],
    "damageDealt": [
      {
        "field": "element",
        "map": {
          "golpe": "hitBlunt",
          "fuego": "spellFire",
          "frio": "spellCold",
          "rayo": "spellLightning",
          "agua": "surfaceSteam"
        },
        "fallback": "hitBlunt"
      },
      { "field": "targetId", "map": { "willy": "crowdBoo" } }
    ],
    "conditionApplied": { "field": "condition", "map": { "eliminado": "eliminated" } },
    "exploded": { "sfx": ["explosion", "barrelBreak"] },
    "surfaceChanged": { "arrayField": "changes", "itemField": "to", "map": { "fuego": "surfaceIgnite", "hielo": "surfaceFreeze", "vapor": "surfaceSteam" } },
    "statChanged": { "field": "stat", "map": { "nivel": "levelUp" } },
    "mapChanged": { "sfx": "mapWhoosh" },
    "entityPushed": { "field": "into", "map": { "void": "crowdApplause" } },
    "trapSpotted": { "sfx": "trapClick" },
    "trapTriggered": { "sfx": "trapSpring" },
    "trapDisarmed": { "sfx": ["diceRoll", "trapClick"] },
    "trapDisarmFailed": { "sfx": ["diceRoll", "trapSpring"] },
    "dialogueCheck": [{ "sfx": "diceRoll" }, { "field": "result.success", "map": { "true": "gameshowDing", "false": "gameshowBuzzer" } }],
    "dialogueChoice": { "sfx": "uiClick" },
    "clockWarning": { "field": "pct", "map": { "50": "clockWarning", "25": "clockWarning", "10": "clockUrgent" }, "fallback": "clockWarning" },
    "roomCollapsing": { "field": "fase", "map": { "grieta": "roomCrack", "caida": "roomCollapse" } },
    "boxOpened": { "field": "rarezaMax", "map": { "bronce": "boxOpen", "plata": "boxOpen", "oro": "boxOpenRare", "legendaria": "boxOpenRare" }, "fallback": "boxOpen" },
    "achievementUnlocked": { "sfx": "achievement" },
    "bossPhase": { "sfx": "bossPhase" },
    "trapdoorOpened": { "sfx": "trapdoor" },
    "rivalEncountered": { "sfx": "rivalSting" }
  },
  "outcomeMusic": { "field": "winner", "map": { "concursantes": "victory" }, "fallback": "defeat" },
  "combatMusicByEntity": {
    "arrayField": "order",
    "map": {
      "jefe-centollo": "bossGeneric",
      "jefe-encargada": "bossGeneric",
      "jefe-giganton": "bossGeneric",
      "jefe-socorrista": "bossGeneric",
      "jefe-presentador": "bossPresentador"
    }
  },
  "maps": {
