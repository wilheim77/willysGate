    "prueba-castro": { "ambience": { "src": "assets/audio/ambience/planta-1.ogg", "volume": 0.7 } },
    "planta-1": { "ambience": { "src": "assets/audio/ambience/planta-1.ogg", "volume": 0.7 } },
